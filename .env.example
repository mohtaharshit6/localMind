# LocalMind Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (optional - app works without it for search/indexing)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model to use
GEMINI_MODEL=gemini-1.5-flash

# Maximum number of chunks to retrieve for context
MAX_CONTEXT_CHUNKS=5

# Chunk size for document splitting (characters)
CHUNK_SIZE=800

# Chunk overlap
CHUNK_OVERLAP=100
